{
  "name": "prismatype",
  "version": "1.0.0",
  "description": "Typebox generator for prisma schema",
  "keywords": [
    "code-generation",
    "prisma",
    "prisma-generator",
    "prisma-schema",
    "prismatype",
    "typebox",
    "typebox-generator"
  ],
  "homepage": "https://github.com/raghu2x/prismatype",
  "license": "MIT",
  "author": {
    "name": "Raghvendra Yadav",
    "url": "https://github.com/raghu2x"
  },
  "repository": {
    "url": "https://github.com/raghu2x/prismatype.git"
  },
  "bin": {
    "prismatype": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run build && bunx prisma generate",
    "build": "bun run typecheck && bun build.ts",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@prisma/generator-helper": "^7.9.0",
    "oxfmt": "^0.60.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@prisma/client": "7.9.0",
    "@types/bun": "latest",
    "oxlint": "^1.75.0",
    "prisma": "7.9.0",
    "typescript": "^7.0.2",
    "vitepress": "^2.0.0-alpha.18"
  }
}
